{
  "name": "steelesh.dev",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "license": "MIT",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/components/*",
    "#styles/*": "./src/styles/*"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "dev": "vite dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test": "playwright test",
    "verify": "pnpm lint && pnpm check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lucide/svelte": "^1.72.0",
    "@playwright/test": "^1.65.0",
    "@shikijs/transformers": "^4.6.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-svelte": "^3.24.1",
    "feed": "^6.0.0",
    "hast-util-to-string": "^3.0.1",
    "husky": "^9.1.7",
    "mdsvex": "^0.12.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.8"
  }
}
